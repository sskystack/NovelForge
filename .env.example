# Local development only. Replace credentials before any shared deployment.
APP_ENV=development
POSTGRES_DB=novelforge
POSTGRES_USER=novelforge
POSTGRES_PASSWORD=novelforge-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://novelforge:novelforge-local-only@localhost:5432/novelforge
# Use false for plain HTTP localhost only; set true behind HTTPS in shared deployments.
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Redis is not needed by the desktop agent or its in-process local worker.
REDIS_URL=

# The mock profile works offline. For a real provider, configure both model names
# and keep the API key on the backend. A base URL normally includes /v1.
AI_PROVIDER=mock
AI_CHAT_MODEL=mock-chat
AI_EMBEDDING_MODEL=mock-embedding
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30

# Per-author settings can also be saved through /api/v1/settings/ai.
# API keys and MCP tokens are write-only in responses, but currently stored in
# the local SQLite database (desktop file permission 0600), not an OS keychain.
# No MCP server is started by default. Author registration, an explicit tool
# allowlist, per-run opt-in, and per-call approval are all required for agent use.
