# Local development only. Replace credentials before any shared deployment.
POSTGRES_DB=novelforge
POSTGRES_USER=novelforge
POSTGRES_PASSWORD=novelforge-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://novelforge:novelforge-local-only@localhost:5432/novelforge
# Use false for plain HTTP localhost only; set true behind HTTPS in shared deployments.
SESSION_COOKIE_SECURE=false
# Redis is optional for local development; production worker deployments require it.
REDIS_URL=
