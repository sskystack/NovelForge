{
  "name": "@novelforge/desktop",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm --prefix ../web run dev",
    "build": "npm --prefix ../web run build",
    "tauri:build": "npm --prefix ../web run build && tauri build",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "sidecar": "uv run --directory ../api pyinstaller --noconfirm --clean --onefile --name novelforge-api --distpath src-tauri/binaries --workpath .pyinstaller-work --specpath .pyinstaller-spec ../api/novelforge/desktop_entry.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  }
}
