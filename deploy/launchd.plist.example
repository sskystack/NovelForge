<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>dev.novelforge.api</string>
<key>ProgramArguments</key><array><string>/opt/novelforge/scripts/start-api.sh</string></array>
<key>WorkingDirectory</key><string>/opt/novelforge</string>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
</dict></plist>
